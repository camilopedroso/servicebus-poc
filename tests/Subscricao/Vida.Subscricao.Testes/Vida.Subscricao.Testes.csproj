<Project Sdk="Microsoft.NET.Sdk">

  <!-- Testes de unidade da squad de Subscrição: regras de subscrição, endossos e o contrato publicado. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- xUnit v3: o projeto de teste é um executável -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Subscricao\Vida.Subscricao\Vida.Subscricao.csproj" />
    <ProjectReference Include="..\..\..\src\Subscricao\Vida.Subscricao.Contratos\Vida.Subscricao.Contratos.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
