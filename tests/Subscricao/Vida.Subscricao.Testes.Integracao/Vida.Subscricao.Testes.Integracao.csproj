<Project Sdk="Microsoft.NET.Sdk">

  <!-- Testes de integração da squad de Subscrição: inbox + negócio + outbox contra um SQL Server de verdade. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- xUnit v3: o projeto de teste é um executável -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <!-- SQL Server de verdade num container descartável: precisa do Docker rodando -->
    <PackageReference Include="Testcontainers.MsSql" Version="4.16.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Subscricao\Vida.Subscricao\Vida.Subscricao.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
