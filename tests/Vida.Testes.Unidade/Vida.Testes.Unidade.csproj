<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- xUnit v3: o projeto de teste é um executável -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Plataforma\Vida.Plataforma\Vida.Plataforma.csproj" />
    <ProjectReference Include="..\..\src\Propostas\Vida.Propostas.Contratos\Vida.Propostas.Contratos.csproj" />
    <ProjectReference Include="..\..\src\Subscricao\Vida.Subscricao.Contratos\Vida.Subscricao.Contratos.csproj" />
    <ProjectReference Include="..\..\src\Vida.Consumer\Vida.Consumer.csproj" />
    <ProjectReference Include="..\..\src\Vida.Producer\Vida.Producer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
