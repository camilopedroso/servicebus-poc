<?xml version="1.0" encoding="utf-8"?>
<!--
  Etapa 10: entre squads, o código chega como pacote, não como ProjectReference. O feed "vida" é uma pasta local
  (pacotes/, fora do git), preenchida por publicar-pacotes.ps1; num cenário real seria Azure Artifacts.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="vida" value="pacotes" />
  </packageSources>
  <!--
    Package source mapping: cada pacote só pode vir do feed indicado. Sem isso, um pacote "Vida.Plataforma" publicado
    por alguém no nuget.org com versão maior poderia ser baixado no lugar do nosso (dependency confusion).
  -->
  <packageSourceMapping>
    <packageSource key="vida">
      <package pattern="Vida.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
