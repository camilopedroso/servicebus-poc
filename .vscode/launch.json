{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Subscrição",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Subscricao/Vida.Subscricao/bin/Debug/net10.0/Vida.Subscricao.dll",
      "cwd": "${workspaceFolder}/src/Subscricao/Vida.Subscricao",
      "console": "integratedTerminal",
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        // Uma mensagem por vez: com 4 em paralelo, o passo a passo pula entre threads.
        "Subscricao__MaxConcurrentCalls": "1"
      }
    },
    {
      "name": "Propostas",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Propostas/Vida.Propostas/bin/Debug/net10.0/Vida.Propostas.dll",
      "cwd": "${workspaceFolder}/src/Propostas/Vida.Propostas",
      "console": "integratedTerminal"
    },
    {
      "name": "Cobrança",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Cobranca/Vida.Cobranca/bin/Debug/net10.0/Vida.Cobranca.dll",
      "cwd": "${workspaceFolder}/src/Cobranca/Vida.Cobranca",
      "console": "integratedTerminal",
      "env": { "DOTNET_ENVIRONMENT": "Development" }
    },
    {
      "name": "Notificação",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Notificacao/Vida.Notificacao/bin/Debug/net10.0/Vida.Notificacao.dll",
      "cwd": "${workspaceFolder}/src/Notificacao/Vida.Notificacao",
      "console": "integratedTerminal",
      "env": { "DOTNET_ENVIRONMENT": "Development" }
    },
    {
      "name": "Operação",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Operacao/Vida.Operacao/bin/Debug/net10.0/Vida.Operacao.dll",
      "cwd": "${workspaceFolder}/src/Operacao/Vida.Operacao",
      "console": "integratedTerminal",
      "env": { "DOTNET_ENVIRONMENT": "Development" }
    },
    {
      "name": "Cobrança (sem build)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/Cobranca/Vida.Cobranca/bin/Debug/net10.0/Vida.Cobranca.dll",
      "cwd": "${workspaceFolder}/src/Cobranca/Vida.Cobranca",
      "console": "integratedTerminal",
      "env": { "DOTNET_ENVIRONMENT": "Development" },
      "presentation": { "hidden": true }
    },
    {
      "name": "Notificação (sem build)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/Notificacao/Vida.Notificacao/bin/Debug/net10.0/Vida.Notificacao.dll",
      "cwd": "${workspaceFolder}/src/Notificacao/Vida.Notificacao",
      "console": "integratedTerminal",
      "env": { "DOTNET_ENVIRONMENT": "Development" },
      "presentation": { "hidden": true }
    },
    {
      "name": "Operação (sem build)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/Operacao/Vida.Operacao/bin/Debug/net10.0/Vida.Operacao.dll",
      "cwd": "${workspaceFolder}/src/Operacao/Vida.Operacao",
      "console": "integratedTerminal",
      "env": { "DOTNET_ENVIRONMENT": "Development" },
      "presentation": { "hidden": true }
    },
    {
      "name": "Subscrição (sem build)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/Subscricao/Vida.Subscricao/bin/Debug/net10.0/Vida.Subscricao.dll",
      "cwd": "${workspaceFolder}/src/Subscricao/Vida.Subscricao",
      "console": "integratedTerminal",
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "Subscricao__MaxConcurrentCalls": "1"
      },
      "presentation": { "hidden": true }
    },
    {
      "name": "Propostas (sem build)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/Propostas/Vida.Propostas/bin/Debug/net10.0/Vida.Propostas.dll",
      "cwd": "${workspaceFolder}/src/Propostas/Vida.Propostas",
      "console": "integratedTerminal",
      "presentation": { "hidden": true }
    }
  ],
  "compounds": [
    {
      // Compila uma vez só (dois builds em paralelo brigam pelos mesmos arquivos) e sobe os dois.
      "name": "Subscrição + Propostas",
      "preLaunchTask": "build",
      "configurations": ["Subscrição (sem build)", "Propostas (sem build)"],
      "stopAll": true
    },
    {
      "name": "Fluxo completo (todos os serviços)",
      "preLaunchTask": "build",
      "configurations": [
        "Subscrição (sem build)",
        "Cobrança (sem build)",
        "Notificação (sem build)",
        "Operação (sem build)",
        "Propostas (sem build)"
      ],
      "stopAll": true
    }
  ]
}
