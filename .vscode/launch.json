{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Consumer",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Vida.Consumer/bin/Debug/net10.0/Vida.Consumer.dll",
      "cwd": "${workspaceFolder}/src/Vida.Consumer",
      "console": "integratedTerminal",
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        // Uma mensagem por vez: com 4 em paralelo, o passo a passo pula entre threads.
        "Consumer__MaxConcurrentCalls": "1"
      }
    },
    {
      "name": "Producer",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Vida.Producer/bin/Debug/net10.0/Vida.Producer.dll",
      "cwd": "${workspaceFolder}/src/Vida.Producer",
      "console": "integratedTerminal"
    },
    {
      "name": "Cobrança",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Cobranca/Vida.Cobranca/bin/Debug/net10.0/Vida.Cobranca.dll",
      "cwd": "${workspaceFolder}/src/Cobranca/Vida.Cobranca",
      "console": "integratedTerminal",
      "env": { "DOTNET_ENVIRONMENT": "Development" }
    },
    {
      "name": "Notificação",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Notificacao/Vida.Notificacao/bin/Debug/net10.0/Vida.Notificacao.dll",
      "cwd": "${workspaceFolder}/src/Notificacao/Vida.Notificacao",
      "console": "integratedTerminal",
      "env": { "DOTNET_ENVIRONMENT": "Development" }
    },
    {
      "name": "Cobrança (sem build)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/Cobranca/Vida.Cobranca/bin/Debug/net10.0/Vida.Cobranca.dll",
      "cwd": "${workspaceFolder}/src/Cobranca/Vida.Cobranca",
      "console": "integratedTerminal",
      "env": { "DOTNET_ENVIRONMENT": "Development" },
      "presentation": { "hidden": true }
    },
    {
      "name": "Notificação (sem build)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/Notificacao/Vida.Notificacao/bin/Debug/net10.0/Vida.Notificacao.dll",
      "cwd": "${workspaceFolder}/src/Notificacao/Vida.Notificacao",
      "console": "integratedTerminal",
      "env": { "DOTNET_ENVIRONMENT": "Development" },
      "presentation": { "hidden": true }
    },
    {
      "name": "Consumer (sem build)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/Vida.Consumer/bin/Debug/net10.0/Vida.Consumer.dll",
      "cwd": "${workspaceFolder}/src/Vida.Consumer",
      "console": "integratedTerminal",
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "Consumer__MaxConcurrentCalls": "1"
      },
      "presentation": { "hidden": true }
    },
    {
      "name": "Producer (sem build)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/Vida.Producer/bin/Debug/net10.0/Vida.Producer.dll",
      "cwd": "${workspaceFolder}/src/Vida.Producer",
      "console": "integratedTerminal",
      "presentation": { "hidden": true }
    }
  ],
  "compounds": [
    {
      // Compila uma vez só (dois builds em paralelo brigam pelos mesmos arquivos) e sobe os dois.
      "name": "Consumer + Producer",
      "preLaunchTask": "build",
      "configurations": ["Consumer (sem build)", "Producer (sem build)"],
      "stopAll": true
    },
    {
      "name": "Fluxo completo (Consumer + Cobrança + Notificação + Producer)",
      "preLaunchTask": "build",
      "configurations": ["Consumer (sem build)", "Cobrança (sem build)", "Notificação (sem build)", "Producer (sem build)"],
      "stopAll": true
    }
  ]
}
