<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Squad de Cobrança. Conhece só os contratos de quem ela assina (Subscrição) e a plataforma. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Da própria squad: ProjectReference. Das outras squads: pacote com versão (feed local, publicar-pacotes.ps1). -->
  <ItemGroup>
    <PackageReference Include="Vida.Plataforma" Version="1.0.0" />
    <PackageReference Include="Vida.Subscricao.Contratos" Version="1.0.0" />
    <PackageReference Include="Vida.LogsAoVivo" Version="1.0.0" />
    <PackageReference Include="Vida.Telemetria" Version="1.0.0" />
  </ItemGroup>

</Project>
