{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Em Information, o EF loga cada comando SQL: o polling do outbox geraria uma linha por segundo no painel.
      "Microsoft.EntityFrameworkCore": "Warning",
      "Azure": "Warning"
    }
  },
  // Porta fixa: o painel (web/painel) chama os cenários e lê os logs em http://localhost:5180.
  "Urls": "http://localhost:5180"
}
