{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Azure": "Warning"
    }
  },
  // Porta fixa: o painel (web/painel) lê os logs em http://localhost:5181/logs.
  // Segunda instância (competing consumers): dotnet run --project src\Vida.Consumer -- --urls http://localhost:5191
  "Urls": "http://localhost:5181",
  "Consumer": {
    "MaxConcurrentCalls": 4
  }
}
