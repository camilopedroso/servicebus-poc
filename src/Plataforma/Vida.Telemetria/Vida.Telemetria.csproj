<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Publicado como pacote (publicar-pacotes.ps1): mudou, sobe a versão. Quem consome atualiza quando quiser. -->
    <Version>1.0.0</Version>
    <Description>OpenTelemetry para o Application Insights (e OTLP local), com as convenções da POC.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Extensões de WebApplicationBuilder -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.OpenTelemetry" Version="1.2.0" />
  </ItemGroup>

</Project>
