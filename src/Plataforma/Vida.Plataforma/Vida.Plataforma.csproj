<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Publicado como pacote (publicar-pacotes.ps1): mudou, sobe a versão. Quem consome atualiza quando quiser. -->
    <Version>1.0.0</Version>
    <Description>Chassis da squad de Plataforma: ServiceBusClient, liga/desliga de processors, leitura estrita de contratos.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- ProcessadoresController (liga/desliga) e extensões de WebApplicationBuilder -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
  </ItemGroup>

</Project>
